{
  "name": "assistant-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "up": "node --env-file-if-exists=.env scripts/up.mjs",
    "dev": "concurrently -k -n api,ui \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --env-file-if-exists=.env --watch backend/server.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test backend/tests/*.test.js",
    "test:frontend": "vitest run --config frontend/vite.config.js",
    "mcp:finance": "node --env-file-if-exists=.env backend/finance/cli.js",
    "trading:runtime": "node --env-file-if-exists=.env backend/trading/cli.js runtime",
    "mcp:trading": "node --env-file-if-exists=.env backend/trading/cli.js mcp_server"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/ollama": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.1.2",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.0",
    "supertest": "^7.1.4",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
