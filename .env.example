PORT=2610
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
# Docker Model Runner, vLLM, or another OpenAI-compatible server:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://MAC_LAN_IP:18035/v1
# LLM_MODEL=exact-id-from-the-server-model-list
# LLM_API_KEY=local-no-key
# Use json_object if the server cannot compile the application's JSON schemas.
LLM_STRUCTURED_OUTPUT=json_schema
# Enable for Qwen servers supporting chat_template_kwargs.enable_thinking.
LLM_DISABLE_THINKING=false
# Legacy aliases, used only with LLM_PROVIDER=vllm:
# VLLM_BASE_URL=http://127.0.0.1:18020/v1
# VLLM_MODEL=qwen3.8-27b
# VLLM_API_KEY=local-no-key
SEMANTIC_DB_PATH=semantic_memory.db
# Optional Python interpreter override; defaults to the repository's .venv.
# MCP_PYTHON=/absolute/path/to/python
# Windows example (executable path only, without arguments):
# MCP_PYTHON=C:\path with spaces\project\.venv\Scripts\python.exe
# Development proxy target (React runs on port 2611).
AGENT_API_URL=http://localhost:2610
# Independent trading execution service (must match runtime and MCP clients).
TRADING_RUNTIME_PORT=2612
# TRADING_DATA_DIR=/absolute/path/to/artifacts/trading/runtime
